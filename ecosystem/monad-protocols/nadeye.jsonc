{
    "name": "Nadeye",
    "description": "An open provenance registry for AI-generated images: confident verdicts are recorded on Monad by perceptual hash, so resized or recompressed copies still match, and each detector builds ERC-8004 reputation. Detection runs on the user's device (Chrome extension) or in a verifier agent reachable over MCP, HTTP and the ERC-8004 Validation Registry. A PasskeyRegistry binds accounts to WebAuthn passkeys verified with the P256 precompile.",
    "live": true,
    "categories": [
        "AI::Infrastructure",
        "Infra::Identity",
        "AI::Consumer AI"
    ],
    "addresses": {
        // verdict registry: attestations by perceptual hash, points, ERC-8004 agent links and consensus feedback
        "Nadeye": "0xD58eb04fb34E9b9151484BE82F2114B75323cDD5",
        // binds accounts to WebAuthn passkeys, verified with the P256 precompile; verifyFor() for passkey approval
        "PasskeyRegistry": "0x16Bef696F687aC253d38B7eA4c84075375EB31B3",
        "NadeyeJournal": "0x3EDd9026A3ad114c67F6cF50EA00e7C93F740a18"
    },
    "links": {
        "project": "https://nadeye.vercel.app",
        "github": "https://github.com/safwaanDK/nadeye",
        "docs": "https://github.com/safwaanDK/nadeye#readme"
    }
}

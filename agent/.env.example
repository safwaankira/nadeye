# Nadeye agent: copy to agent/.env (never commit .env)
NADEYE_NETWORK=mainnet            # or testnet
NADEYE_CONTRACT=0x...             # your deployed Nadeye address
# A dedicated, low-balance wallet for the agent (pays gas for validation responses + attestations)
AGENT_PRIVATE_KEY=0x...
# Filled in after `npm run register`
AGENT_ID=
# Optional
# NADEYE_RPC=https://rpc.monad.xyz
# PORT=8787
# HOST=127.0.0.1                      # keep local unless you put it behind a tunnel
# AGENT_ATTEST=1                      # also record verdicts in Nadeye as a scanner
# REQUESTER_PRIVATE_KEY=0x...         # only for the `request` demo command
# HTTP API exposure (the tunnel host from --public-url is allowed automatically)
# NADEYE_ALLOWED_HOSTS=agent.example.com          # extra Host names to answer to
# NADEYE_CORS_ORIGINS=https://your-site.example   # browser origins allowed to call /verify and /mcp
# Validator spend limits
# NADEYE_VALIDATOR_MAX_PER_HOUR=30    # answers per requesting agent per hour
# NADEYE_VALIDATOR_MIN_BALANCE=0.05   # MON; below this, requests wait for a top-up

# PixelProof agent — copy to agent/.env (never commit .env)
PIXELPROOF_NETWORK=mainnet            # or testnet
PIXELPROOF_CONTRACT=0x...             # your deployed PixelProof address
# A dedicated, low-balance wallet for the agent (pays gas for validation responses + attestations)
AGENT_PRIVATE_KEY=0x...
# Filled in after `npm run register`
AGENT_ID=
# Optional
# PIXELPROOF_RPC=https://rpc.monad.xyz
# PORT=8787
# HOST=127.0.0.1                      # keep local unless you put it behind a tunnel
# AGENT_ATTEST=1                      # also record verdicts in PixelProof as a scanner
# REQUESTER_PRIVATE_KEY=0x...         # only for the `request` demo command

# Create a HyperSync token at https://envio.dev/app/api-tokens (free)
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"
# From the deploy script's output
ENVIO_NADEYE_ADDRESS=0x...
ENVIO_PASSKEYS_ADDRESS=0x...
# Optional: the Nadeye deploy block (faster first sync), and the verifier agent's wallet
# to count only its validation answers (otherwise any validator using the tag is indexed)
ENVIO_START_BLOCK=0
ENVIO_VERIFIER_ADDRESS=
